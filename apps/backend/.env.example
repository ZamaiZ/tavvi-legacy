PORT=3002
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=public-anon-key
# Notifications. The same server key as Web (APP_SERVER_KEY) and as the
# database (select public.set_app_server_key('<key>');). Authorizes the push
# claim and POST /api/v1/internal/push/deliver.
APP_SERVER_KEY=replace-with-48-random-bytes-base64url
# Web Push (VAPID). Generate with: pnpm --filter tavvi-backend push:keys
# The public key is also NEXT_PUBLIC_VAPID_PUBLIC_KEY on Web; the private
# key stays here. VAPID_SUBJECT: mailto:contact@domain or https://domain.
VAPID_PUBLIC_KEY=public-key-base64url
VAPID_PRIVATE_KEY=private-key-base64url
VAPID_SUBJECT=mailto:contact@your-domain.com
