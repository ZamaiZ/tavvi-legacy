{
  "expo": {
    "name": "tavvi-mobile",
    "slug": "tavvi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tavvi-icon.png",
    "scheme": "tavvimobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tavvi-icon.png"
    },
    "android": {
      "package": "com.tavvi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0D0C0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que a Tavvi use o Face ID para proteger o acesso ao console administrativo."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0C0A",
          "image": "./assets/images/tavvi-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0D0C0A",
            "image": "./assets/images/tavvi-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc331619-3ca4-4e99-80f7-b2f139c5782c"
      }
    },
    "owner": "zamaiz"
  }
}
