NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
API_BASE_URL=http://localhost:3002

# Web Push (VAPID). Gere o par com: pnpm --filter tavvi-backend push:keys
# Só a pública fica aqui (painel. e admin. se inscrevem com ela). A privada e
# o VAPID_SUBJECT ficam na API Express, que envia os pushes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-base64url

# Chave das funções exclusivas do servidor (feedback anônimo e push).
# A mesma chave vai na API Express (APP_SERVER_KEY em apps/backend/.env).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Depois rode no editor de SQL do Supabase, com A MESMA chave:
#   select public.set_app_server_key('<chave>');
APP_SERVER_KEY=troque-por-uma-chave-com-48-bytes-aleatorios-base64url

# Opcional, só em desenvolvimento: faz o host exato do túnel (ngrok) servir
# um território privado (admin ou painel). Sem o subdomínio, pois o
# certificado *.ngrok-free.dev não cobre painel.<túnel>.
# DEV_TUNNEL_TERRITORY vazia: o túnel serve o cardápio público (/<slug>).
# DEV_TUNNEL_HOST=seu-tunel.ngrok-free.dev
# DEV_TUNNEL_TERRITORY=painel
