NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
API_BASE_URL=http://localhost:3002

# Web Push (VAPID). Gere o par com: pnpm --filter @tavvi/web push:keys
# A pública é a mesma em painel. e admin.; a privada nunca vai ao navegador.
# VAPID_SUBJECT: mailto:contato@dominio ou https://dominio (não localhost).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-base64url
VAPID_PRIVATE_KEY=chave-privada-base64url
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# Opcional, só em desenvolvimento: faz o host exato do túnel (ngrok) servir
# um território privado (admin ou painel). Sem o subdomínio, pois o
# certificado *.ngrok-free.dev não cobre painel.<túnel>.
# DEV_TUNNEL_HOST=seu-tunel.ngrok-free.dev
# DEV_TUNNEL_TERRITORY=painel
