{
  "name": "tavvi-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "approve-build": "pnpm approve-builds",
    "back": "pnpm --filter ./apps/backend dev",
    "web": "pnpm --filter ./apps/web dev",
    "dev": "pnpm --recursive --parallel --stream --filter ./apps/backend --filter ./apps/web run dev",
    "ngrok": "pnpm --filter ./apps/backend exec ngrok http 3002"
  }
}
