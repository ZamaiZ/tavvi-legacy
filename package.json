{
  "name": "tavvi-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "approve-build": "pnpm approve-builds",
    "back": "pnpm --filter @tavvi/api-contracts build && pnpm --filter ./apps/backend dev",
    "expo": "pnpm --filter @tavvi/api-contracts build && pnpm --filter ./apps/mobile start",
    "web": "pnpm --filter @tavvi/api-contracts build && pnpm --filter ./apps/web dev",
    "dev": "pnpm --filter @tavvi/api-contracts build && pnpm --recursive --parallel --stream --filter ./apps/backend --filter ./apps/mobile --filter ./apps/web run dev",
    "dev:back-web": "pnpm --filter @tavvi/api-contracts build && pnpm --recursive --parallel --stream --filter ./apps/backend --filter ./apps/web run dev",
    "dev:back-expo": "pnpm --filter @tavvi/api-contracts build && pnpm --recursive --parallel --stream --filter ./apps/backend --filter ./apps/mobile run dev",
    "dev:web": "pnpm dev:back-web",
    "dev:mobile": "pnpm dev:back-expo",
    "ngrok": "pnpm --filter ./apps/backend exec ngrok http 3002"
  }
}
